{
  "environment": "{{ ENV \"APP_ENVIRONMENT\" }}",
  "log_level": "{{ ENV \"LOG_LEVEL\" }}",
  "auth": {
    "jwt": {
      "secret_key": "{{ ENV \"JWT_SECRET_KEY\" }}"
    },
    "bootstrap": {
      "full_name": "Lotty Admin",
      "email": "admin@example.invalid",
      "password_hash": "{{ ENV \"BOOTSTRAP_PASSWORD_HASH\" }}"
    }
  },
  "database": {
    "postgres": {
      "dsn": "{{ ENV \"POSTGRES_DSN\" }}"
    },
    "redis": {
      "address": "{{ ENV \"REDIS_ADDRESS\" }}"
    },
    "s3": {
      "bucket": "{{ ENV \"S3_BUCKET\" }}",
      "region": "{{ ENV \"S3_REGION\" }}",
      "endpoint": "{{ ENV \"S3_ENDPOINT\" }}",
      "access_key": "{{ ENV \"S3_ACCESS_KEY\" }}",
      "secret_key": "{{ ENV \"S3_SECRET_KEY\" }}"
    },
    "kafka": {
      "brokers": "{{ ENV \"KAFKA_BROKERS\" }}"
    },
    "clickhouse": {
      "dsn": "{{ ENV \"CLICKHOUSE_DSN\" }}"
    }
  },
  "panel": {
    "http": {
      "address": "{{ ENV \"PANEL_HTTP_ADDRESS\" }}"
    }
  },
  "runtime": {
    "http": {
      "address": "{{ ENV \"RUNTIME_HTTP_ADDRESS\" }}"
    },
    "max_stale_age": "5m",
    "revalidate_interval": "5s",
    "kafka": {
      "group_id": "{{ ENV \"KAFKA_SNAPSHOT_GROUP_ID\" }}",
      "decisions_topic": "{{ ENV \"RUNTIME_KAFKA_DECISIONS_TOPIC\" }}"
    }
  },
  "analytics": {
    "http": {
      "address": "{{ ENV \"ANALYTICS_HTTP_ADDRESS\" }}"
    },
    "kafka": {
      "group_id": "{{ ENV \"ANALYTICS_KAFKA_GROUP_ID\" }}",
      "pipeline_group_id": "{{ ENV \"ANALYTICS_KAFKA_PIPELINE_GROUP_ID\" }}",
      "ingest_group_id": "{{ ENV \"ANALYTICS_KAFKA_INGEST_GROUP_ID\" }}",
      "attribution_group_id": "{{ ENV \"ANALYTICS_KAFKA_ATTRIBUTION_GROUP_ID\" }}",
      "events_topic": "{{ ENV \"ANALYTICS_EVENTS_TOPIC\" }}",
      "exposures_topic": "{{ ENV \"ANALYTICS_EXPOSURES_TOPIC\" }}",
      "decisions_topic": "{{ ENV \"ANALYTICS_DECISIONS_TOPIC\" }}",
      "events_validated_topic": "{{ ENV \"ANALYTICS_EVENTS_VALIDATED_TOPIC\" }}",
      "events_deduped_topic": "{{ ENV \"ANALYTICS_EVENTS_DEDUPED_TOPIC\" }}",
      "dlq_topic": "{{ ENV \"ANALYTICS_DLQ_TOPIC\" }}"
    },
    "clickhouse": {
      "batch_size": 1000,
      "flush_interval": "1s"
    },
    "attribution": {
      "window_days": 7,
      "late_event_grace_hours": 1
    },
    "pii": {
      "hash_subject_id": true,
      "salts": {
        "v1": "{{ ENV \"ANALYTICS_PII_SALT_V1\" }}"
      },
      "current_salt_version": "v1"
    }
  }
}